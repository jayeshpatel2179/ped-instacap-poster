TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Same Upload-Post credentials/profile the PedTalks Extra bot uses to publish
# to Instagram (see the sibling pedtalks-insta-image project's .env).
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# Optional: comma-separated Telegram user IDs allowed to tap "Confirm & Post"
# (e.g. 111111111,222222222). Leave empty to allow anyone in the chat/group.
POST_ALLOWED_USER_IDS=
