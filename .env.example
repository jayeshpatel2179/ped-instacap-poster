TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Same Upload-Post credentials/profile the PedTalks Extra bot uses to publish
# to Instagram (see the sibling pedtalks-insta-image project's .env).
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# PedTalks website upload API - posted to first, before Instagram, on every image.
# x-api-key value provided by the PedTalks website team.
WEBSITE_UPLOAD_API_KEY=
# Optional override; defaults to https://www.pedtalkssports.com/api/instagram/upload
WEBSITE_UPLOAD_URL=

# Optional: comma-separated Telegram user IDs allowed to tap "Go Live Website" /
# "Go Live Instagram" (e.g. 111111111,222222222). Leave empty to allow anyone in the chat/group.
POST_ALLOWED_USER_IDS=
